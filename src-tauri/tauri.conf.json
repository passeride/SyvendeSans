{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "SyvendeSans",
  "version": "0.1.0",
  "identifier": "no.syvendesans.app",
  "build": {
    "beforeDevCommand": "npm run dev -- --port 5173 --strictPort",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "SyvendeSans", "width": 1120, "height": 760 }]
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.png", "icons/icon.ico"]
  }
}
